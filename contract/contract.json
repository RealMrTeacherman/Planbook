              "min": 1,
              "max": 20
            },
            "day": {
              "type": "int",
              "min": 1,
              "max": 7
            },
            "lesson": {
              "type": "int",
              "min": 0,
              "max": 60
            },
            "k": {
              "type": "enum",
              "values": [
                "diag",
                "open",
                "probe",
                "review",
                "assess",
                "bench",
                "summ"
              ]
            },
            "text": {
              "type": "string",
              "max": 120,
              "nameCheck": true
            }
          },
          "nullable": true
