        "weeksPerUnit": {
          "type": "int",
          "min": 1,
          "max": 20,
          "nullable": true
        },
        "daysPerWeek": {
          "type": "int",
          "min": 1,
          "max": 7,
          "nullable": true
        },
        "lessonsPerUnit": {
          "type": "int",
          "min": 1,
          "max": 60,
          "nullable": true
        },
        "pacing": {
          "type": "bool",
          "note": "Math follows the Reveal pacing guide"
        },
        "benchmark": {
          "type": "bool",
          "note": "Reading follows Benchmark Advance"
        },
        "picks": {
          "type": "array",
          "max": 12,
          "of": {
            "type": "string",
            "max": 40
          },
          "note": "quick choices for a free-text subject"
        }
      }
    },
    "block": {
      "owner": "planner",
      "space": "live",
      "readers": [
        "subplans"
      ],
      "idPrefix": "blk",
      "idRule": "random",
      "fromV95": "lp:settings:v2.templates",
      "note": "One block of one weekday's schedule. It runs until the next block starts.",
