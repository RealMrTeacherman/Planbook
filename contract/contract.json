      "contract": {
        "type": "const",
        "required": true,
        "value": "classroom-suite-display"
      },
      "version": {
        "type": "const",
        "required": true,
        "value": 1
      },
      "date": {
        "type": "date",
        "required": true
      },
      "groups": {
        "type": "array",
